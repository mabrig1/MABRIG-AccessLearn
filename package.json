{
  "name": "mabrig-accesslearn",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests/agent-core.test.ts",
    "check": "npm run check:offline && npm run test && npm run build",
    "deploy:worker": "npm run build && wrangler deploy",
    "check:offline": "node --experimental-strip-types tests/offline-upgrade.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@supabase/supabase-js": "^2.57.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.46.0"
  }
}
